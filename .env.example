# Copy to .env.local and fill in real values. .env.local is gitignored.
# Spring Boot picks these up via ${VAR} placeholders in application.yaml.
# Load into your shell with:   set -a; source .env.local; set +a
# Or use a launcher like direnv / foreman / your IDE's run-config env support.

# ---------- Required: LLM (OpenRouter) ----------
# Concept generation, reference-image analysis, AI Studio overview LLM.
OPENROUTER_API_KEY=

# Spring AI's OpenAI starter requires this bean at boot. Any non-empty value
# works since OpenRouter is wired as @Primary. Also used directly by
# OpenAiImageClient when imageProvider=OPENAI on the legacy poster endpoint.
OPENAI_API_KEY=placeholder

# ---------- Required: Recraft (default image gen for AI Studio) ----------
# Needed for POST /api/v1/ai/events/concept and for per-vibe style training.
RECRAFT_API_KEY=

# ---------- Optional: Replicate (Ideogram fallback/experiments) ----------
# Must start with r8_. Only needed when explicitly routing a poster request to Replicate/Ideogram.
REPLICATE_API_TOKEN=

# ---------- Required: Cloudflare R2 media storage ----------
# Only needed when MEDIA_ENABLED=true (the default). Set to false to skip
# the upload/delete endpoints entirely.
MEDIA_ENABLED=true
R2_BUCKET=imin-media-dev
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_PREFIX=https://media-dev.your-domain.com/
R2_REGION=auto

# ---------- Required: Stripe ----------
# sk_test_... locally, sk_live_... in prod. App fails to start without this.
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` output. Only needed for the webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional: platform fee. Defaults shown.
# STRIPE_APPLICATION_FEE_BPS=500
# STRIPE_APPLICATION_FEE_FIXED_MINOR=99
# STRIPE_PUBLIC_RETURN_URL_BASE=http://localhost:3000
# STRIPE_RETURN_URL_BASE=http://localhost:5173

# ---------- Required: Resend (transactional email) ----------
# Auth emails (signup verification, password reset) fail without this.
RESEND_API_KEY=
# Optional: sender identity. Defaults shown.
# IMIN_EMAIL_FROM_ADDRESS=contact@imin.support
# IMIN_EMAIL_FROM_NAME=imin
# IMIN_EMAIL_REPLY_TO=contact@imin.support
# IMIN_APP_BASE_URL=http://localhost:3000

# ---------- Redis (rate limiting) ----------
# Default matches the dev docker-compose service (port 6380 → 6379).
# Railway: set to the connection string from the Redis plugin
# (format: redis://default:PASSWORD@HOST:PORT), typically ${{Redis.REDIS_URL}}.
# REDIS_URL=redis://localhost:6380

# ---------- Optional: Sentry ----------
# SENTRY_DSN=

# ---------- Optional: CORS ----------
# Comma-separated list of allowed origin patterns. Defaults cover localhost dev
# and the known prod/preview domains; only override if you add a new frontend origin.
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173,...

# ---------- Optional: tuning ----------
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_MODEL=openai/gpt-4o-mini
# IMIN_REFERENCE_ANALYZER_MODEL=openai/gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_IMAGE_MODEL=gpt-image-1
# RECRAFT_BASE_URL=https://external.api.recraft.ai/v1
# RECRAFT_MODEL=recraftv3
# RECRAFT_BASE_STYLE=realistic_image
# REPLICATE_IMAGE_STORAGE_DIR=./generated-images
# IDEOGRAM_TURBO_MODEL=ideogram-ai/ideogram-v3-turbo
# IDEOGRAM_QUALITY_MODEL=ideogram-ai/ideogram-v3-quality
